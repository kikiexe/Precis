{
  "name": "precis-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @precis/landing dev",
    "dev:landing": "pnpm --filter @precis/landing dev",
    "dev:app": "pnpm --filter @precis/app dev",
    "dev:pos": "pnpm --filter @precis/pos dev",
    "dev:superadmin": "pnpm --filter @precis/superadmin dev",
    "dev:all": "pnpm -r --parallel dev",
    "landing": "pnpm --filter @precis/landing dev",
    "app": "pnpm --filter @precis/app dev",
    "pos": "pnpm --filter @precis/pos dev",
    "superadmin": "pnpm --filter @precis/superadmin dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && (cd backend && php artisan test)"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
